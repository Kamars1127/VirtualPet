# =========================================
# Visual Studio
# =========================================

# Visual Studio 暫存資料、使用者設定、快取等
.vs/


# =========================================
# Build output
# =========================================

# 忽略所有專案底下的 bin 資料夾
**/bin/

# 忽略所有專案底下的 obj 資料夾
**/obj/


# =========================================
# Test Projects
# =========================================

# 測試專案不會被 dotnet publish 用到，不需要進 Image
# 排除後可以縮小 build context、加快 docker build 傳輸速度
VirtualPet.Domain.Tests/
VirtualPet.Web.IntegrationTests/


# =========================================
# Git
# =========================================

# Git Repository 內部資料
.git/

# Git 忽略規則檔本身
.gitignore


# =========================================
# Docker
# =========================================

# 不將 Dockerfile 複製進 Image
Dockerfile*

# 忽略傳統命名的 Docker Compose 檔案
docker-compose*

# 不將 .dockerignore 本身複製進 Image
.dockerignore

# 忽略新版 Compose YAML 設定檔
compose*.yml
compose*.yaml


# =========================================
# User-specific files
# =========================================

# Visual Studio 使用者專屬設定
*.user
*.suo


# =========================================
# Logs
# =========================================

# 忽略 Log 檔案
*.log


# =========================================
# OS files
# =========================================

# macOS 系統檔案
.DS_Store

# Windows 縮圖快取
Thumbs.db


# =========================================
# Test Results
# =========================================

# 忽略 dotnet test / Visual Studio 測試產生的結果
TestResults/


# =========================================
# Environment Variables
# =========================================

# 避免環境變數、密碼、連線資訊等被複製進 Image
.env
