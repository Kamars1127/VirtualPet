@model PetDetailsViewModel

@{
    ViewData["Title"] = Model.Pet.Name;
}

<div class="mb-4">
    <a asp-controller="Pet" asp-action="Index" class="btn btn-outline-secondary">← Back</a>
    <div id="pet-action-message" class="alert d-none" role="alert"></div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="card-title">@Model.Pet.Name</h1>
                <hr />
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Species</strong>
                        <div>@Model.Pet.Species</div>
                    </div>
                    <div class="col-md-6">
                        <strong>Evolution Stage</strong>
                        <div id="pet-evolution-stage">@Model.Pet.EvolutionStage</div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Level</strong>
                        <div id="pet-level">@Model.Pet.Level</div>
                    </div>
                    <div class="col-md-6">
                        <strong>Experience</strong>
                        <div id="pet-experience">@Model.Pet.Experience / 100</div>
                    </div>
                </div>
                <div class="mb-3">
                    <strong>State</strong>
                    <div id="pet-state">@Model.Pet.State</div>
                </div>

                <div class="mb-3">
                    <strong>Last Status Update</strong>
                    <div id="pet-last-status-update">
                        @Model.Pet.LastStatusUpdateAt.ToString("yyyy-MM-dd HH:mm:ss") UTC
                    </div>
                </div>

                <hr />

                <h4>Status</h4>

                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <span>Satiety</span>

                        <span>
                            <span id="pet-satiety">@Model.Pet.Satiety</span> / 100
                        </span>
                    </div>
                    <div class="progress">
                        <div id="pet-satiety-bar" class="progress-bar" style="width: @Model.Pet.Satiety%"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <span>Happiness</span>
                        <span>
                            <span id="pet-happiness">@Model.Pet.Happiness</span> / 100
                        </span>
                    </div>
                    <div class="progress">
                        <div id="pet-happiness-bar" class="progress-bar" style="width: @Model.Pet.Happiness%"></div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between">
                        <span>Energy</span>
                        <span>
                            <span id="pet-energy">@Model.Pet.Energy</span> / 100
                        </span>
                    </div>
                    <div class="progress">
                        <div id="pet-energy-bar" class="progress-bar" style="width: @Model.Pet.Energy%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
    <div class="card shadow-sm">
        <div class="card-body">
            <h4>Actions</h4>

            <div class="d-grid gap-2">
                <form asp-controller="Pet" asp-action="Feed" asp-route-id="@Model.Pet.Id" method="post" class="js-pet-action">
                    <button type="submit" class="btn btn-success w-100">Feed</button>
                </form>

                <form asp-controller="Pet" asp-action="Play" asp-route-id="@Model.Pet.Id" method="post" class="js-pet-action">
                    <button type="submit" class="btn btn-primary w-100">Play</button>
                </form>

                <form asp-controller="Pet" asp-action="Rest" asp-route-id="@Model.Pet.Id" method="post" class="js-pet-action">
                    <button type="submit" class="btn btn-secondary w-100">Rest</button>
                </form>

                <form asp-controller="Pet" asp-action="GainExperience" asp-route-id="@Model.Pet.Id" method="post" class="js-pet-action">
                    <button type="submit" class="btn btn-warning w-100">Train (+25 EXP)</button>
                </form>
            </div>
        </div>
    </div>
</div>
</div>



<div class="card shadow-sm mt-4">
    <div class="card-body">
        <h4>History</h4>

        @if(Model.Histories.Count == 0)
        {
            <p class="text-muted mb-0">尚無操作紀錄。</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Description</th>
                            <th>Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var history in Model.Histories)
                        {
                            <tr>
                                <td>@history.ActionType</td>
                                <td>@history.Description</td>
                                <td>@history.CreateAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div id="pet-details" data-status-url="@Url.Action("Status","Pet",new{id = Model.Pet.Id})"></div>